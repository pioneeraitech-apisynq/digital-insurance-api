PORT=3002
POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev
CLAIMS_API_URL=https://claims.digitalinsurance.dev

# OpenAI, used by the reply draft helper (src/ai/reply-draft.agent.ts).
# OPENAI_BASE_URL points the client at the APISynQ gateway rather than
# api.openai.com, so the call is recorded and the data-class policy is applied:
#   OPENAI_BASE_URL=https://governance-api.apisynq.com/v1/ai-gw/openai/v1
OPENAI_BASE_URL=https://governance-api.apisynq.com/v1/ai-gw/openai/v1

# Key-governance requirements (apply these when issuing the production key):
#
#   1. EXPIRATION  – Set an explicit expiration date on the project API key
#                    via the OpenAI dashboard (Platform → API keys → Edit).
#                    Maximum recommended lifetime: 90 days.
#
#   2. MAX LIFETIME – Enforce an organisation-level maximum key lifetime in
#                    the OpenAI organisation settings so keys cannot be
#                    created without an expiry.
#
#   3. SERVICE ACCOUNT – Issue keys only from a dedicated service-account
#                    identity, not from individual user accounts.  Restrict
#                    key creation to that identity via organisation IAM.
#
#   4. ROTATION    – Rotate the key before its expiration date; delete the
#                    old key immediately after rotation is confirmed.
#
# Replace the placeholder below with the service-account key; never commit a
# real key to version control.
OPENAI_API_KEY=replace-me
