PORT=3002
POLICY_API_URL=https://policy.digitalinsurance.dev
PAYMENT_API_URL=https://payment.digitalinsurance.dev
CLAIMS_API_URL=https://claims.digitalinsurance.dev
OPENAI_BASE_URL=https://governance-api.apisynq.com/v1/ai-gw/openai/v1

# ──────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY — credential governance requirements
#
# 1. EXPIRATION (required): every key used here MUST be created with an
#    expiration date in the OpenAI platform (platform.openai.com →
#    API keys → "Set expiration"). The organisation policy is a maximum
#    lifetime of 90 days. Keys with no expiry MUST NOT be used.
#
# 2. ROTATION: rotate the key before its expiry date and update this value
#    (or the secret-manager reference) before the old key is invalidated.
#
# 3. PREFERRED — workload identity / short-lived tokens: for production
#    workloads, replace this long-lived key with a short-lived token issued
#    by your identity provider (workload identity federation) so that no
#    static secret needs to be stored in environment files at all.
#
# 4. DO NOT COMMIT real keys: this file is tracked by git for local-dev
#    defaults only. Real keys must be injected at runtime via a secrets
#    manager (e.g. AWS Secrets Manager, GCP Secret Manager, Vault) or a
#    CI/CD secret store — never hard-coded or committed.
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-a-scoped-expiring-key
